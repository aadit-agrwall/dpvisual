#!/usr/bin/env bash
# usage: bash lib3d/render_page.sh scenes/chapter05/page147.py Page147 page147
cd "$(dirname "$0")/.." || exit 1
F="$1"; C="$2"; N="$3"
LOG=lib3d/last_render.log
mkdir -p assets/user-data/output
source .venv/bin/activate 2>/dev/null
{
  echo "== check file =="
  [ -f "$F" ] && echo "REPORT: OK file exists" || { echo "REPORT: FAIL $F missing"; exit 1; }
  echo "== import test =="
  PYTHONPATH="$PWD" python -c "
import importlib.util
s=importlib.util.spec_from_file_location('m','$F')
m=importlib.util.module_from_spec(s); s.loader.exec_module(m)
assert hasattr(m,'$C')
print('REPORT: OK import')" || { echo "REPORT: FAIL import"; exit 1; }
  echo "== render 1080p =="
  PYTHONPATH="$PWD" manim -qh "$F" "$C" -o "$N" || { echo "REPORT: FAIL render"; exit 1; }
  OUTF=$(find media/videos -name "$N.mp4" -print0 | xargs -0 ls -t 2>/dev/null | head -n 1)
  if [ -n "$OUTF" ]; then
    cp "$OUTF" "assets/user-data/output/$N.mp4"
    echo "REPORT: OK saved assets/user-data/output/$N.mp4"
  else
    echo "REPORT: FAIL output not found"
  fi
} > "$LOG" 2>&1
echo "---- last 40 lines of $LOG ----"
tail -n 40 "$LOG"
grep "REPORT:" "$LOG"
